# 复制成 .env 后按需修改。.env 不会进 Git（见根目录 .gitignore）。

# JWT 签名密钥。换成你自己的随机字符串，泄露等于登录凭证可以被伪造。
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-string

# 登录有效期（分钟）。默认 30 天，单人自用不必频繁登录。
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# 数据库文件位置，相对 backend/ 目录。SQLite 不需要安装任何服务。
DATABASE_FILE=data/freedom_design.db

# 文章插图的上传目录，相对 backend/ 目录。
UPLOAD_DIR=uploads

# ---- AI 模块（第三期 F11~F13）----

# 阿里云百炼 API Key。控制台 → API-KEY 管理 → 创建。
# 不填也不会崩：AI 模块会报「未配置 key」，其余模块照常可用。
DASHSCOPE_API_KEY=

# OpenAI 兼容接口地址。**换供应商只改这一行**，三家的地址：
#   阿里云百炼   https://dashscope.aliyuncs.com/compatible-mode/v1
#   硅基流动     https://api.siliconflow.cn/v1
#   智谱         https://open.bigmodel.cn/api/paas/v4
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 向量化模型与维度 —— ★ 这两个必须配套，改一个就必须改另一个，并且要重建索引。
# 旧模型和新模型的向量不在同一个向量空间，混用不会报错，只会检索出莫名其妙的内容。
# 所以 knowledge_chunk 表里存了每块用的模型名和维度，状态接口会报「有多少块该重建了」。
AI_EMBEDDING_MODEL=text-embedding-v4
AI_EMBEDDING_DIM=1024

# 对话模型。★ 百炼会定期下线旧模型，报 model not found 时先来这里换一个新名字，
# 不用改代码。当前有效：qwen3.7-flash / qwen3.7-plus / qwen3.8-max 等。
AI_CHAT_MODEL=qwen3.7-flash

# 思考模式。实测同一个 RAG 问题：开 = 9.6 秒 / 662 个思考 token，关 = 2.4 秒 / 0。
# 问答以「从我的文章里找出来、归纳」为主，不需要深度推理，默认关闭。
AI_CHAT_THINKING=false

# 检索：取最相关的前 K 块；最高分低于 MIN_SCORE 就认为知识库里没有相关内容，
# 走 F13 的通用回答（并标注「未引用你的文章」）。
# ★ MIN_SCORE 是初始猜测值，真实用几次之后要回来调：调太低会硬塞不相关的文章给模型，
#   回答会变牵强；调太高会明明有相关文章却走了通用回答。
AI_RETRIEVAL_TOP_K=5
AI_RETRIEVAL_MIN_SCORE=0.35

# 切块：目标字数 / 相邻块重叠字数（防止答案正好被切在边界上，两边都不完整）。
AI_CHUNK_SIZE=500
AI_CHUNK_OVERLAP=100
