# 复制成 .env 后按需修改。.env 不会进 Git（见根目录 .gitignore）。

# JWT 签名密钥。换成你自己的随机字符串，泄露等于登录凭证可以被伪造。
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-string

# 登录有效期（分钟）。默认 30 天，单人自用不必频繁登录。
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# 数据库文件位置，相对 backend/ 目录。SQLite 不需要安装任何服务。
DATABASE_FILE=data/freedom_design.db

# 文章插图的上传目录，相对 backend/ 目录。
UPLOAD_DIR=uploads
